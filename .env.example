# EBRAINS IAM / Keycloak (same realm the wizard uses)
IAM_BASE_URL=https://iam.ebrains.eu/auth
IAM_REALM=hbp
CURATION_VALIDATOR_OIDC_CLIENT_ID=
CURATION_VALIDATOR_OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# EBRAINS Knowledge Graph
KG_API_BASE=https://core.kg.ebrains.eu/v3
KG_STAGE=IN_PROGRESS

# Login scope; add collab.drive to read the data descriptor and the metadata draft from the Collab drive
OIDC_SCOPE=openid profile email team roles group collab.drive
DRIVE_BASE=https://drive.ebrains.eu
DATA_PROXY_BASE=https://data-proxy.ebrains.eu/api/v1

# Language model for the AI review (any OpenAI chat-completions service, e.g. the university's GPT UiO).
# Leave empty to switch the review off. The key stays on the server.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_LABEL=GPT UiO
# max_tokens, or max_completion_tokens for Azure GPT-5 style models
LLM_MAX_TOKENS_PARAM=max_tokens

# App
SESSION_SECRET=change-me
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=./data
